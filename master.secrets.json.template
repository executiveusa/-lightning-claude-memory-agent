{
  "_meta": {
    "version": "1.0.0",
    "description": "Master secrets file for all projects - DO NOT COMMIT TO VERSION CONTROL",
    "created": "2025-12-06",
    "notes": [
      "This file should be stored securely on your local machine",
      "Copy this template to master.secrets.json and fill in real values",
      "Never commit master.secrets.json to git",
      "Each project has its own section with required and optional secrets"
    ]
  },
  "projects": {
    "agent-lightning": {
      "name": "Agent Lightning",
      "repository": "executiveusa/-lightning-claude-memory-agent",
      "core_secrets": {
        "OPENAI_API_KEY": "sk-YOUR-ACTUAL-KEY-HERE",
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_API_BASE": "https://api.openai.com/v1"
      },
      "optional_secrets": {
        "TINKER_API_KEY": "",
        "WANDB_API_KEY": "",
        "AGENTOPS_API_KEY": "dummy",
        "AGENTOPS_API_ENDPOINT": "",
        "ANSWERER_LLM": "gpt-5-mini",
        "SEARCH_LLM": "gpt-4.1",
        "MODEL": "gpt-4.1-mini",
        "VERL_SPIDER_DATA_DIR": "data",
        "CREWAI_DISABLE_TELEMETRY": "true"
      },
      "runtime_config": {
        "AGL_MANAGED_STORE": "false",
        "AGL_CURRENT_ROLE": "",
        "AGL_SERVER_HOST": "localhost",
        "AGL_SERVER_PORT": "",
        "PYTHONUTF8": "1"
      },
      "deployment": {
