# Railway Zero-Secrets Deployment - Environment Template
# This file shows all available environment variables with safe defaults
# Copy values from master.secrets.json as needed

# ===== CORE SECRETS (REQUIRED) =====
# OpenAI API key for LLM inference
OPENAI_API_KEY=token-abc123

# OpenAI API base URL (can be proxy or vLLM endpoint)
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative OpenAI API base URL (legacy compatibility)
OPENAI_API_BASE=https://api.openai.com/v1

# ===== OPTIONAL INTEGRATIONS =====
# Leave empty or use defaults to stub these integrations

# Tinker API key for fine-tuning via Tinker service
# Module: tinker
# When empty: Tinker training disabled, local training only
TINKER_API_KEY=

# Weights & Biases API key for experiment tracking
# Module: wandb
# When empty: W&B logging disabled, metrics logged locally only
WANDB_API_KEY=

# AgentOps API key for agent monitoring and tracing
# Module: agentops
# When empty: AgentOps uses internal dummy endpoint
AGENTOPS_API_KEY=dummy

# AgentOps API endpoint URL
# Module: agentops
# When empty: 
AGENTOPS_API_ENDPOINT=

# Model name for answerer agent in Q20 example
# Module: tinker
# When empty: 
ANSWERER_LLM=gpt-5-mini

# Model name for search agent in Q20 example
# Module: tinker
# When empty: 
SEARCH_LLM=gpt-4.1

# Default model name for SQL agent
# Module: spider
# When empty: 
MODEL=gpt-4.1-mini

# Directory path for Spider dataset in SQL agent
# Module: spider
# When empty: 
VERL_SPIDER_DATA_DIR=data

# Disable CrewAI telemetry to prevent conflicts with AgentOps
# Module: crewai
# When empty: 
CREWAI_DISABLE_TELEMETRY=true

# ===== RUNTIME CONFIGURATION =====

# Enable Agent Lightning managed store mode
AGL_MANAGED_STORE=false

# Current role in distributed Agent Lightning setup
AGL_CURRENT_ROLE=

# Agent Lightning server host
AGL_SERVER_HOST=localhost

# Agent Lightning server port
AGL_SERVER_PORT=

# Enable UTF-8 mode for Python
PYTHONUTF8=1
